# Copy this file to ".env" and fill in the paths on your machine.
# ".env" is listed in .gitignore and is never committed.
# This project needs no API keys or passwords; the variables below are file paths and
# compute settings only. Do not put credentials (e.g. a GitHub token) in this file.

# Raw UFFCSData archive (https://github.com/tmp1986/UFFCSData, master branch, commit b5128e6):
# the folder that contains one sub-folder per session (RAW_DATABASE/RAW_DATABASE)
UFFCS_RAW_DIR=data/raw/UFFCSData/RAW_DATABASE/RAW_DATABASE

# Curated release: the folder with the 35 selected sessions (DATABASE_SELECTED_DATA/DATABASE)
UFFCS_SELECTED_DIR=data/raw/UFFCSData/DATABASE_SELECTED_DATA/DATABASE

# Curated release as a single table
UFFCS_DATASET_CSV=data/raw/UFFCSData/dataset.csv

# Parallel folds per model fit (2 = use two CPU cores; 1 = run two stages side by side)
FA_NJOBS=2

# Threads used inside each gradient-boosting fit (leave empty for the library default)
OMP_NUM_THREADS=
